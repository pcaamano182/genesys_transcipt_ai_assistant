# =============================================================================
# Genesys Cloud
# =============================================================================
GENESYS_CLIENT_ID=your_client_id_here
GENESYS_CLIENT_SECRET=your_client_secret_here
GENESYS_REGION=us_west_2

# Grant type for Genesys OAuth2:
#   client_credentials  - default, no browser needed. Use when the OAuth app
#                         in Genesys was created with "Client Credentials" grant.
#   authorization_code  - opens browser for interactive login. Requires a
#                         redirect URI registered in the Genesys OAuth app.
GENESYS_GRANT_TYPE=client_credentials

# =============================================================================
# Google Cloud
# =============================================================================
# GCP project where Vertex AI is enabled. Your user account must have
# the "Vertex AI User" role on this project.
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# =============================================================================
# GCP OAuth2 client override — OPTIONAL, leave empty in most cases.
#
# The app uses the embedded Google Cloud SDK OAuth client by default,
# so no extra setup is needed: just run `gtaa auth gcp-login` and log in
# with your corporate SSO account in the browser that opens.
#
# Only set these if your organisation requires using a custom registered
# OAuth app instead of the default Google Cloud SDK client.
# =============================================================================
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=
