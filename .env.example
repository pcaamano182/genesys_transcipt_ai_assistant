# =============================================================================
# Genesys Cloud
# =============================================================================
GENESYS_CLIENT_ID=your_client_id_here
GENESYS_CLIENT_SECRET=your_client_secret_here
GENESYS_REGION=us_west_2

# Grant type for Genesys OAuth2:
#   client_credentials  - default, no browser needed. Use when the OAuth app
#                         in Genesys was created with "Client Credentials" grant.
#   authorization_code  - opens browser for interactive login. Requires a
#                         redirect URI registered in the Genesys OAuth app.
GENESYS_GRANT_TYPE=client_credentials

# =============================================================================
# Google Cloud
# =============================================================================
# GCP project where Vertex AI is enabled. The service account must have
# the "Vertex AI User" role (roles/aiplatform.user) on this project.
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# Path to the service account JSON key file.
# Run `gtaa auth gcp-login --key-file path/to/sa.json --project PROJECT_ID`
# to configure authentication, or set this env var directly:
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
